// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(cuid())

  name         String
  email        String @unique
  passwordHash String

  candidate CandidateProfile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

enum ExperienceLevel {
  STUDENT
  FRESHER
  JUNIOR
  MID
  SENIOR
}

model CandidateProfile {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  targetRole String?

  experienceLevel ExperienceLevel?

  readinessScore Float @default(0)

  interviewsTaken Int @default(0)

  resumeSummary String?

  topSkills Json?

  currentResumeId String? @unique

  currentResume Resume? @relation("CurrentResume", fields: [currentResumeId], references: [id])

  resumes Resume[] @relation("CandidateResumes")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SkillCategory {
  LANGUAGE
  FRONTEND
  BACKEND
  DATABASE
  DEVOPS
  CLOUD
  AI_ML
  TOOLS
  OTHER
}

model ResumeSkill {
  id String @id @default(cuid())

  resumeId String

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  name String

  category SkillCategory?

  confidence Float?

  @@index([resumeId])
  @@index([name])
}

model ResumeProject {
  id String @id @default(cuid())

  resumeId String

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  name String

  description String?

  technologies Json

  createdAt DateTime @default(now())

  @@index([resumeId])
}

model ResumeEducation {
  id String @id @default(cuid())

  resumeId String

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  institution String

  degree String?

  fieldOfStudy String?

  graduationYear Int?

  createdAt DateTime @default(now())

  @@index([resumeId])
}

enum ResumeStatus {
  PROCESSING
  READY
  FAILED
}

model Resume {
  id String @id @default(cuid())

  candidateId String

  candidate CandidateProfile @relation("CandidateResumes", fields: [candidateId], references: [id], onDelete: Cascade)

  currentForCandidate CandidateProfile? @relation("CurrentResume")

  fileName String

  fileUrl String

  publicId String

  rawText String

  summary String

  status ResumeStatus @default(PROCESSING)

  uploadedAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  skills ResumeSkill[]

  projects ResumeProject[]

  educations ResumeEducation[]

  @@index([candidateId])
}
